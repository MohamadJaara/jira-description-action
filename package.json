{
  "name": "jira-description-action",
  "version": "0.7.0",
  "description": "Add JIRA issue details to your GitHub pull request",
  "main": "lib/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('.build', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "engines-ok && tsc --project tsconfig.build.json && ncc build .build/main.js -o lib -m",
    "postbuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && jest",
    "test:watch": "jest --watch",
    "prettier": "prettier --write '**/*.ts'",
    "prepare": "husky",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cakeinpanic/jira-description-action"
  },
  "engines": {
    "node": ">=24.11"
  },
  "keywords": [
    "actions",
    "github-actions",
    "pr-title",
    "node",
    "setup",
    "github",
    "jira-summary",
    "jira",
    "jira-issue"
  ],
  "author": "cakeinpanic",
  "license": "MIT",
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.44.1",
    "axios": "^1.19.0",
    "babel-jest": "^30.4.1",
    "engines-ok": "^1.2.0",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "release-it": "^21.0.0",
    "typescript": "^7.0.2",
    "@release-it/conventional-changelog": "^12.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0",
    "undici": "^7.29.0"
  }
}
